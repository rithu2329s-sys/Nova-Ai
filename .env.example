# Copy this file to .env. Never upload .env or share your API key.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Hybrid routing: auto | local | cloud
AI_MODE=auto

# Local model (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional cloud model using an OpenAI-compatible Chat Completions endpoint.
# For OpenAI: https://api.openai.com/v1/chat/completions
CLOUD_API_URL=
CLOUD_API_KEY=
CLOUD_MODEL=

# Optional app-level access token. If set, send it in x-nova-token.
# Use a long random value; do not put it in frontend files.
NOVA_ACCESS_TOKEN=
